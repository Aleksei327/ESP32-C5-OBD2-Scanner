# XIAO ESP32-C5: консоль по встроенному USB Serial/JTAG
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Wi-Fi + веб-сервер не влезают в 1 МБ приложения по умолчанию
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Тик 1 мс: паузы между кадрами ISO-TP (STmin) и опрос по таймерам — в миллисекундах
CONFIG_FREERTOS_HZ=1000

# WebSocket для связи с приложением
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
