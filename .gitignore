# KiCad: резервные копии, кэш, блокировки, локальные настройки вида
*-backups/
*.kicad_prl
fp-info-cache
*.lck
~*.lck
\#auto_saved_files#
_autosave-*

# Выходные файлы проверок: в репозиторий идут только PDF
hardware/**/build/*
!hardware/**/build/*.pdf

# Фото покупных модулей (права продавцов) — только локально
DOCS/img/

# Python
__pycache__/
*.pyc

# ESP-IDF
firmware/**/build/
firmware/**/managed_components/
firmware/**/sdkconfig.old
firmware/**/sdkconfig

# VS Code Local History
.history/

# Flutter (на всякий случай, у app свой .gitignore)
app/build/
app/.dart_tool/
**/.flutter-plugins-dependencies

# Flutter: переводы генерируются из .arb при flutter pub get
app/lib/l10n/gen/

# Скачанный архив PSA-RE и списки для перевода (app/tool/build_kb.py)
app/tool/.cache/

# Удалённый помощник: ключ текущего сеанса (remote/relay.py)
remote/.session.json
